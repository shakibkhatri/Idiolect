{
  "name": "idiolect",
  "version": "0.1.2",
  "type": "module",
  "bin": {
    "idiolect": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "cp ../../README.md ."
  },
  "dependencies": {
    "@shakibkhatri/idiolect-core": "workspace:*",
    "@shakibkhatri/idiolect-eval": "workspace:*",
    "commander": "^13.0.0",
    "@shakibkhatri/idiolect-mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shakibkhatri/Idiolect.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Learn your coding style from git history and feed it to AI coding agents",
  "keywords": [
    "ai",
    "claude",
    "cursor",
    "copilot",
    "mcp",
    "code-style",
    "linter",
    "kotlin",
    "typescript",
    "python",
    "go"
  ]
